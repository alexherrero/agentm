{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/memory-automemory-note.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
